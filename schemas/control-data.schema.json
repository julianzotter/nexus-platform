{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NEXUS Control Panel data (generated by tools/build_control_data.py)",
  "type": "object",
  "required": ["schemaVersion", "asOf", "timezone", "policy", "links", "projects", "orders", "architecture",
               "moe", "roles", "chatTasks", "computerJobs", "navigation", "reports", "nexus"],
  "properties": {
    "schemaVersion": {"const": "4.2.0"},
    "asOf": {"type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"},
    "projects": {"type": "array", "items": {"type": "object", "required": ["id", "title", "state"]}},
    "orders": {"type": "array", "items": {"type": "array", "minItems": 9, "maxItems": 9}},
    "roles": {"type": "array", "minItems": 1,
              "items": {"type": "array", "prefixItems": [{"type": "string", "pattern": "^ID\\d\\d$"}],
                        "minItems": 5, "maxItems": 5, "items": {"type": "string"}}},
    "nexus": {
      "type": "object",
      "required": ["sourceCommit", "inputs", "workflows", "skills", "ledger", "reportFiles", "surfaces", "monitor"],
      "properties": {
        "sourceCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "inputs": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "string"},
                   {"type": "string", "pattern": "^[0-9a-f]{64}$"}], "minItems": 2, "maxItems": 2}},
        "workflows": {"type": "object", "required": ["version", "pipeline", "items"],
                      "properties": {"items": {"type": "array", "minItems": 1,
                        "items": {"type": "array", "prefixItems": [{"type": "string", "pattern": "^WF-\\d\\d$"}],
                                  "minItems": 4, "maxItems": 4}}}},
        "skills": {"type": "object", "required": ["counts", "items"],
                   "properties": {"items": {"type": "array", "items": {"type": "array", "minItems": 5, "maxItems": 5}}}},
        "ledger": {"type": "object", "required": ["entries", "nextFreeId", "lastDate", "latest"]},
        "reportFiles": {"type": "object", "required": ["rule", "entries", "byState", "items"],
                        "properties": {"items": {"type": "array", "items": {"type": "array", "minItems": 5, "maxItems": 5,
                          "prefixItems": [{"type": "string"}, {"type": "string"}, {"type": "string"},
                                          {"enum": ["REGISTERED", "NOT_IN_LEDGER", "LEDGER_PENDING", "UNREGISTERED", "NAME_NONCONFORM"]}]}}}},
        "surfaces": {"type": "object", "required": ["version", "rule", "byRole", "items"],
                     "properties": {"items": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 7, "maxItems": 7,
                       "prefixItems": [{"type": "string", "pattern": "^UI-\\d\\d$"},
                                       {"enum": ["CANONICAL_DISPLAY", "LOCAL_BACKEND", "PROTOTYPE", "REPORT_VIEW", "TOOL", "ARCHIVED"]}]}}}},
        "monitor": {"type": "object", "required": ["status"],
                    "properties": {"status": {"enum": ["PASS", "INCOMPLETE", "ATTENTION", "NO_DATA", "STALE_COMMIT"]}}}
      }
    }
  }
}
