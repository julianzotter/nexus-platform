{
  "version": "1.3.0-draft",
  "default_temperature": 0,
  "providers": {
    "perplexity": {
      "kind": "openai_compat",
      "base_url": "https://api.perplexity.ai",
      "model": "sonar-pro",
      "env_key": "PERPLEXITY_API_KEY"
    },
    "claude": {
      "kind": "anthropic",
      "base_url": "https://api.anthropic.com",
      "model": "claude-sonnet-4-5",
      "env_key": "ANTHROPIC_API_KEY"
    },
    "gpt": {
      "kind": "openai_compat",
      "base_url": "https://api.openai.com/v1",
      "model": "gpt-5",
      "env_key": "OPENAI_API_KEY",
      "supports_temperature": false
    },
    "gemini": {
      "kind": "gemini",
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "model": "gemini-2.5-pro",
      "env_key": "GEMINI_API_KEY"
    },
    "local": {
      "kind": "ollama",
      "base_url": "http://localhost:11434",
      "model": "qwen2.5:7b",
      "env_key": null,
      "num_ctx": 16384
    },
    "vision": {
      "kind": "gcv_ocr",
      "base_url": "https://vision.googleapis.com/v1",
      "model": "DOCUMENT_TEXT_DETECTION",
      "env_key": "GOOGLE_VISION_API_KEY"
    },
    "deepseek": {
      "kind": "openai_compat",
      "base_url": "https://api.deepseek.com",
      "model": "deepseek-flash",
      "env_key": "DEEPSEEK_API_KEY",
      "supports_temperature": false,
      "thinking": "disabled",
      "max_tokens": 512,
      "timeout": 30
    },
    "deepseek_harness": {
      "kind": "dsh",
      "executable": "dsh",
      "env_key": null,
      "timeout": 180
    }
  },
  "routes": {
    "research": {
      "primary": "perplexity",
      "fallback": [
        "gemini",
        "gpt"
      ]
    },
    "norm_check": {
      "primary": "perplexity",
      "fallback": [
        "claude"
      ],
      "council": true
    },
    "code": {
      "primary": "claude",
      "fallback": [
        "gpt",
        "local"
      ]
    },
    "review": {
      "primary": "claude",
      "fallback": [
        "gpt"
      ]
    },
    "draft": {
      "primary": "gpt",
      "fallback": [
        "claude"
      ]
    },
    "long_context": {
      "primary": "gemini",
      "fallback": [
        "claude"
      ]
    },
    "private": {
      "primary": "local",
      "fallback": []
    },
    "engineering_decision": {
      "primary": "claude",
      "fallback": [
        "gpt"
      ],
      "council": true,
      "council_members": [
        "perplexity",
        "claude",
        "gpt",
        "gemini"
      ]
    },
    "ocr": {
      "primary": "vision",
      "fallback": [
        "gemini"
      ]
    },
    "rfem_prompt": {
      "primary": "deepseek",
      "fallback": []
    },
    "rfem_plan": {
      "primary": "deepseek_harness",
      "fallback": []
    }
  },
  "privacy": {
    "confidential_route": "private",
    "markers": [
      "VERTRAULICH",
      "CONFIDENTIAL",
      "[P3]"
    ]
  },
  "lessons_dir": "COMMUNICATION/lessons"
}
