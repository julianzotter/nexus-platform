{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge item (incl. norm clause)",
  "type": "object",
  "required": [
    "id",
    "kind",
    "title",
    "source_file_id",
    "version",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable ID shared with the NEXUS-AI-AEC knowledge graph"
    },
    "kind": {
      "enum": [
        "note",
        "norm_clause",
        "solver",
        "workflow"
      ]
    },
    "title": {
      "type": "string"
    },
    "source_file_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "VALID",
        "SUPERSEDED",
        "DRAFT"
      ]
    },
    "norm": {
      "type": "object",
      "required": [
        "standard",
        "edition",
        "clause"
      ],
      "properties": {
        "standard": {
          "type": "string",
          "description": "e.g. EN 1992-1-1",
          "minLength": 1
        },
        "edition": {
          "type": "string",
          "minLength": 1,
          "description": "Edition/year, e.g. 2015 or 2011-12"
        },
        "national_annex": {
          "type": "string",
          "description": "e.g. ÖNORM B 1992-1-1, DIN EN 1992-1-1/NA"
        },
        "clause": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "engineering_result": {
      "type": "boolean",
      "description": "True if the item carries a computed engineering result; requires a human sign-off before status VALID"
    },
    "signoff": {
      "type": "object",
      "required": [
        "reviewer",
        "decision",
        "decided_at",
        "result_version"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "APPROVED",
            "REJECTED"
          ]
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "result_version": {
          "type": "string",
          "minLength": 1,
          "description": "Must equal the item's version: binds sign-off to the reviewed result"
        },
        "evidence_id": {
          "type": "string",
          "description": "Evidence record (kind human_review)"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "norm_clause"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "norm"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "engineering_result": {
            "const": true
          }
        },
        "required": [
          "engineering_result"
        ]
      },
      "then": {
        "required": [
          "norm"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "engineering_result": {
            "const": true
          },
          "status": {
            "const": "VALID"
          }
        },
        "required": [
          "engineering_result",
          "status"
        ]
      },
      "then": {
        "required": [
          "signoff"
        ],
        "properties": {
          "signoff": {
            "properties": {
              "decision": {
                "const": "APPROVED"
              }
            }
          }
        }
      }
    }
  ]
}
