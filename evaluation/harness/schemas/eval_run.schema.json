{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"eval_run.schema.json","title":"eval_run","version":"1.1.0","type":"object",
"required":["run_id","case_id","timestamp","input_hash","gates","refinements","deltas","failure_class","status","escalation","auto_apply",
            "model_id","prompt_hash","context_manifest_hash","toolset_hash","token_in","token_out"],
"properties":{
 "run_id":{"type":"string"},"parent_run_id":{"type":["string","null"]},"suite_id":{"type":"string"},"case_id":{"type":"string"},
 "task_type":{"type":"string"},"timestamp":{"type":"string"},
 "model_id":{"type":"string"},"model_version":{"type":"string"},
 "prompt_id":{"type":"string"},"prompt_hash":{"$ref":"#/$defs/sha"},"context_manifest_hash":{"$ref":"#/$defs/sha"},
 "toolset_hash":{"$ref":"#/$defs/sha"},"input_hash":{"$ref":"#/$defs/sha"},"output_hash":{"$ref":"#/$defs/sha"},
 "source_refs":{"type":"array","items":{"type":"string"}},
 "gates":{"type":"object","required":["G1","G2","G3","G4"],"properties":{"G5":{"enum":["PASS","FAIL","SKIP","PENDING"]}},"additionalProperties":{"enum":["PASS","FAIL","SKIP"]}},
 "refinements":{"type":"integer","minimum":0,"maximum":3},"deltas":{"type":"integer","minimum":0,"maximum":3},
 "failure_class":{"type":["string","null"],"enum":["F-SOURCE","F-NUM","F-SCOPE","F-TOOL","F-RETRIEVAL","F-HALL","F-JUDGE","F-REPORT","F-REG","F-SEC",null]},
 "status":{"enum":["PASS","FAIL","PARTIAL","NEEDS_REVIEW","BLOCKED","SOURCE_GAP","SOURCE_CONFLICT","REGRESSION","SUPERSEDED"]},
 "escalation":{"type":["string","null"],"enum":["HUMAN_GATE","JUDGE",null]},"auto_apply":{"type":"boolean","const":false},
 "score":{"type":["number","null"],"minimum":0,"maximum":100},"metrics":{"type":"object"},
 "token_in":{"type":"integer","minimum":0},"token_out":{"type":"integer","minimum":0},
 "proposed_delta_ref":{"type":["string","null"]},"artifact_refs":{"type":"array","items":{"type":"string"}}},
"$defs":{"sha":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"additionalProperties":false}
