{
  "$comment": "Antigravity App/IDE/CLI shared MCP config. Global: ~/.gemini/config/mcp_config.json | Workspace: .agents/mcp_config.json (commit-able). Secrets via ${ENV} -> fill from .env, never commit real keys.",
  "mcpServers": {
    "github": {
      "serverUrl": "https://api.githubcopilot.com/mcp/",
      "headers": { "Authorization": "Bearer ${GITHUB_PAT}" },
      "enabledTools": ["search_code","get_file_contents","list_issues","create_issue","list_pull_requests","get_pull_request","search_repositories"],
      "timeout": 180000
    },
    "colab-mcp": {
      "command": "uvx",
      "args": ["git+https://github.com/googlecolab/colab-mcp"],
      "timeout": 30000
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": { "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}" }
    },
    "gemini-api-docs": {
      "serverUrl": "https://gemini-api-docs-mcp.dev"
    }
  }
}
