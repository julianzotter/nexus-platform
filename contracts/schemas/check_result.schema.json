{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexus:aec:contracts:0.1:CheckResult",
  "title": "CheckResult",
  "$comment": "Structural validation only; Python domain invariants are also mandatory.",
  "$ref": "#/$defs/CheckResult",
  "$defs": {
    "CheckResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "enum": [
            "nexus-check/0.1"
          ]
        },
        "model_hash": {
          "type": "string"
        },
        "results_hash": {
          "type": "string"
        },
        "method_id": {
          "type": "string"
        },
        "method_version": {
          "type": "string"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "standards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StandardReference"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        }
      },
      "required": [
        "schema_version",
        "model_hash",
        "results_hash",
        "method_id",
        "method_version",
        "scope",
        "exclusions",
        "standards",
        "evidence",
        "findings"
      ]
    },
    "StandardReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "type": "string"
        },
        "edition": {
          "type": "string"
        },
        "clauses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "national_annex_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "national_annex_edition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "amendments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "document_id",
        "edition",
        "clauses"
      ]
    },
    "EvidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "locator": {
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "uri",
        "version",
        "locator"
      ]
    },
    "Finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "object_ref": {
          "type": "string"
        },
        "state_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "not_evaluated"
          ]
        },
        "message": {
          "type": "string"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "description": "Finite base-10 Decimal. Unit is fixed by the field/contract."
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "object_ref",
        "state_id",
        "status",
        "message",
        "evidence_ids"
      ]
    }
  }
}
