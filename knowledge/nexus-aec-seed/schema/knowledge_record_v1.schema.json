{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:nexus:aec:knowledge-record:v1",
  "title":"NEXUS AEC evidence-backed knowledge record v1",
  "type":"object",
  "additionalProperties":false,
  "required":["record_id","kind","source","evidence_status","scope","properties"],
  "properties":{
    "record_id":{"type":"string","minLength":1},
    "kind":{"enum":["regulation","standard","material","product","assembly","epd","circularity_metric","research","rfem_model_link"]},
    "source":{
      "type":"object","additionalProperties":false,
      "required":["provider_id","source_uri","locator","retrieved_at","version","content_sha256"],
      "properties":{
        "provider_id":{"type":"string","minLength":1},
        "source_uri":{"type":"string","format":"uri"},
        "locator":{"type":"string","minLength":1},
        "retrieved_at":{"type":"string","format":"date-time"},
        "version":{"type":"string","minLength":1},
        "content_sha256":{"oneOf":[{"type":"string","pattern":"^[a-f0-9]{64}$"},{"type":"null"}]},
        "licence":{"type":["string","null"]},
        "access_permission":{"enum":["PUBLIC","LICENSED","UNKNOWN"]}
      }
    },
    "evidence_status":{"enum":["VERIFIED","DERIVED","CALCULATED","INFERRED","UNVERIFIED","BLOCKED"]},
    "scope":{
      "type":"object","additionalProperties":false,
      "required":["country","binding_status"],
      "properties":{
        "country":{"type":"string"},
        "federal_state":{"type":["string","null"]},
        "edition":{"type":["string","null"]},
        "national_annex":{"type":["string","null"]},
        "effective_date":{"type":["string","null"],"format":"date"},
        "binding_status":{"enum":["BINDING_VERIFIED","DRAFT","HISTORICAL","UNKNOWN","NOT_APPLICABLE"]}
      }
    },
    "properties":{"type":"array","items":{"$ref":"#/$defs/property"}},
    "relations":{"type":"array","items":{"type":"object","required":["predicate","target_id"],"properties":{"predicate":{"type":"string"},"target_id":{"type":"string"}}}},
    "engineering_release":{"enum":["NOT_RELEASED","ID01_APPROVED"]}
  },
  "$defs":{
    "property":{
      "type":"object","additionalProperties":false,
      "required":["name","value","unit","stage","locator"],
      "properties":{
        "name":{"enum":["lambda","rho","mu","fire_class","fire_resistance","Rw","E_modulus","f_strength","gwp","ap","odp","pocp","ep","adp","service_life","reusable_share","recycled_content","reversible_connection","layer_group","eta_number","ead_number","zifa_score"]},
        "value":{"type":["number","string","boolean","null"]},
        "unit":{"type":"string"},
        "stage":{"enum":["NONE","A1-A3","A4","A5","B1-B7","C1-C4","D"]},
        "declared_unit":{"type":["string","null"]},
        "dataset_version":{"type":["string","null"]},
        "locator":{"type":"string","minLength":1},
        "verification":{"enum":["VERIFIED","UNVERIFIED","DERIVED","CALCULATED"]}
      }
    }
  }
}
