# Copy to  secrets.env  and fill in. NEVER commit the real file.
# macOS / Linux:  the run wrapper sources this; or run:  set -a && source secrets.env && set +a
#
# World4You: the mailbox password you set in the World4You customer area / webmail.
# Gmail:     an App Password (myaccount.google.com -> Security -> App passwords),
#            NOT your normal login password — requires 2-Step Verification enabled.

export MAIL_PASS_ZOTTERCONSULT="change-me"
export MAIL_PASS_ZTLITSCHAUER="change-me"
export MAIL_PASS_SPLINE="change-me"
export MAIL_PASS_GMAIL="xxxx xxxx xxxx xxxx"
